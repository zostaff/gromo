# GROMO: 5 AI agents, analysis powered by GROKHOOD, trades on FOMO. Copy to .env and fill in. Never commit .env.

# Your own FOMO referral code (links get &r=<code>). Empty = plain links.
FOMO_REF=
# xAI key for the Analyst (Grok judge). Empty = rules judge.
XAI_API_KEY=
# Telegram bot token from @BotFather (desk bot). The first /start in a private chat becomes the owner.
TG_TOKEN=
# Bearer token for the web app and API. Generated on first run if empty.
APP_TOKEN=
# Web Push VAPID pair (base64url raw P-256). Generated on first run if empty.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact claim for Web Push (Apple rejects localhost addresses).
VAPID_SUB=mailto:desk@grokhood.tech
# Bind address of the desk API / web app.
HOST=127.0.0.1
PORT=8890
# Public base URL used in report links and the first-run app URL, e.g. https://desk.example.com
PUBLIC_URL=

# ---- auto trading (LIVE, Solana only) ----
# Desk hot wallet secret key: base58 (Phantom export) or a JSON byte array. A NEW wallet holding only what the
# desk may lose. Empty = no real trades, LIVE sends buttons. Never commit, never paste it anywhere else.
WALLET_PRIVATE_KEY=
# Optional free Jupiter key (developers.jup.ag/portal). Empty = keyless, 0.5 requests/s.
JUP_API_KEY=

# ---- copy bot (python -m copybot.bot) ----
# Privy bearer token of a SEPARATE EMPTY FOMO account (lives about 60 min; refresh with /token in the bot chat).
FOMO_TOKEN=
# Telegram token of the copy bot. Must be a DIFFERENT bot than TG_TOKEN (two processes cannot poll one bot).
COPYBOT_TG_TOKEN=
